<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.appointmentmanagement.ui.auth.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"/>
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.appointmentmanagement.ui.home.HomeFragment"
        android:label="Home" />

    <fragment
        android:id="@+id/bookingFragment"
        android:name="com.example.appointmentmanagement.ui.booking.BookingFragment"
        android:label="Booking" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.appointmentmanagement.ui.profile.ProfileFragment"
        android:label="Profile" />

    <fragment
        android:id="@+id/adminFragment"
        android:name="com.example.appointmentmanagement.ui.admin.AdminFragment"
        android:label="Admin" />
</navigation>
